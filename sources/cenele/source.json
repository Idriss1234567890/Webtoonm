{
  "$schema": "../../schema/source.schema.json",
  "schemaVersion": 1,
  "id": "cenele",
  "name": "فضاء الروايات",
  "lang": "ar",
  "type": "novel",
  "version": 1,
  "baseUrl": "https://cenele.com",
  "nsfw": false,
  "iconUrl": "https://cenele.com/wp-content/uploads/2026/08/cropped-فضاء-روايات-32x32.png",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
    "Referer": "https://cenele.com/",
    "Accept-Language": "ar,en;q=0.8"
  },
  "latest": {
    "verified": true,
    "note": "قالب Madara مخصص (nhv). 10 روايات في الصفحة، 26 صفحة. فرز: m_orderby=latest|views|rating|gems|alphabet.",
    "firstPageUrl": "/cont/?m_orderby=latest",
    "url": "/cont/page/{page}/?m_orderby=latest",
    "list": "article.nhv-library-card",
    "item": {
      "url": {
        "selector": "a.nhv-library-card__cover",
        "attr": "href"
      },
      "title": {
        "selector": "h2.nhv-library-card__title a",
        "attr": "text"
      },
      "cover": {
        "selector": "img",
        "attr": [
          "src",
          "data-src"
        ]
      },
      "status": {
        "selector": ".nhv-library-card__status",
        "attr": "text",
        "optional": true
      },
      "subtitle": {
        "selector": ".nhv-library-card__chip",
        "attr": "text",
        "optional": true
      }
    },
    "nextPage": "a.next.page-numbers"
  },
  "popular": {
    "verified": false,
    "note": "نفس القالب مع m_orderby=views (الرابط من أزرار الفرز، الترقيم لم يُجرَّب).",
    "firstPageUrl": "/cont/?m_orderby=views",
    "url": "/cont/page/{page}/?m_orderby=views",
    "list": "article.nhv-library-card",
    "item": {
      "url": {
        "selector": "a.nhv-library-card__cover",
        "attr": "href"
      },
      "title": {
        "selector": "h2.nhv-library-card__title a",
        "attr": "text"
      },
      "cover": {
        "selector": "img",
        "attr": [
          "src",
          "data-src"
        ]
      },
      "status": {
        "selector": ".nhv-library-card__status",
        "attr": "text",
        "optional": true
      },
      "subtitle": {
        "selector": ".nhv-library-card__chip",
        "attr": "text",
        "optional": true
      }
    },
    "nextPage": "a.next.page-numbers"
  },
  "search": {
    "verified": false,
    "note": "بحث Madara القياسي (post_type=wp-manga). شريط البحث في المكتبة يعمل بـ JS خارجي لذلك لم يُتحقق؛ قد تكون بطاقات النتائج بقالب مختلف (.c-tabs-item__content).",
    "firstPageUrl": "/?s={query}&post_type=wp-manga",
    "url": "/page/{page}/?s={query}&post_type=wp-manga",
    "list": "article.nhv-library-card, .c-tabs-item__content",
    "item": {
      "url": {
        "selector": "a[href*=\"/cont/\"]",
        "attr": "href"
      },
      "title": {
        "selector": "h2.nhv-library-card__title a, .post-title h3 a",
        "attr": "text"
      },
      "cover": {
        "selector": "img",
        "attr": [
          "src",
          "data-src"
        ]
      },
      "status": {
        "selector": ".nhv-library-card__status",
        "attr": "text",
        "optional": true
      }
    },
    "nextPage": "a.next.page-numbers"
  },
  "details": {
    "verified": true,
    "title": {
      "selector": "h1.nhv-novel-title",
      "attr": "text"
    },
    "cover": {
      "selector": ".nhv-novel-cover img",
      "attr": [
        "src",
        "data-src"
      ]
    },
    "description": {
      "selector": ".nhv-novel-synopsis p",
      "attr": "text"
    },
    "genres": {
      "selector": ".nhv-novel-genres a",
      "attr": "text",
      "multiple": true
    },
    "author": {
      "selector": ".nhv-novel-meta a[href*=\"/cont-author/\"]",
      "attr": "text",
      "multiple": true,
      "optional": true
    },
    "status": {
      "selector": ".nhv-novel-status strong",
      "attr": "text"
    },
    "statusMap": {
      "مستمرة": "ongoing",
      "مكتملة": "completed",
      "متوقفة مؤقتًا": "on_hold",
      "متوقفة": "on_hold",
      "ملغاة": "cancelled"
    }
  },
  "chapters": {
    "verified": false,
    "note": "صفحة الرواية تعرض آخر 8 فصول فقط (inline)؛ القائمة الكاملة تُحمَّل بـ JS. نجرب نقطة Madara القياسية POST {الرواية}ajax/chapters/ وإن فشلت نرجع للـ 8 فصول (inlineFallback). روابط الفصول تحتوي اسم المجلد: /cont/slug/مجلد-1-.../الفصل-N/ لذلك لا يمكن synthesize.",
    "request": {
      "method": "POST",
      "url": "{mangaUrl}ajax/chapters/"
    },
    "inlineFallback": true,
    "list": "li.wp-manga-chapter",
    "item": {
      "url": {
        "selector": "a",
        "attr": "href"
      },
      "name": {
        "selector": "a",
        "attr": "ownText"
      },
      "date": {
        "selector": ".chapter-release-date",
        "attr": "text",
        "optional": true
      }
    },
    "numberFromUrl": "(?:%d8%a7%d9%84%d9%81%d8%b5%d9%84|الفصل)-([0-9]+(?:[.-][0-9]+)?)/?$",
    "order": "desc"
  },
  "content": {
    "verified": true,
    "note": "النص داخل .reading-content story-fold كفقرات <p>؛ نصف الفقرات فارغة (تُحذف). نستثني الإعلان (aside الجواهر/VIP) باستعمال story-fold.",
    "paragraphs": ".reading-content story-fold p"
  },
  "home": {
    "url": "/cont/?m_orderby=latest",
    "sections": [
      {
        "container": "main.nhv-library",
        "title": {
          "selector": "h1.nhv-library__title",
          "attr": "text"
        },
        "list": "article.nhv-library-card",
        "item": {
          "url": {
            "selector": "a.nhv-library-card__cover",
            "attr": "href"
          },
          "title": {
            "selector": "h2.nhv-library-card__title a",
            "attr": "text"
          },
          "cover": {
            "selector": "img",
            "attr": [
              "src",
              "data-src"
            ]
          },
          "status": {
            "selector": ".nhv-library-card__status",
            "attr": "text",
            "optional": true
          },
          "subtitle": {
            "selector": ".nhv-library-card__chip",
            "attr": "text",
            "optional": true
          }
        }
      }
    ]
  }
}
