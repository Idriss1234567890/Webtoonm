{
  "$schema": "../../schema/source.schema.json",
  "schemaVersion": 1,
  "id": "starzmanga",
  "name": "مانجا ستارز (Starz Manga)",
  "lang": "ar",
  "version": 1,
  "baseUrl": "https://starzmanga.com",
  "nsfw": false,
  "iconUrl": "https://starzmanga.com/wp-content/512starzmanga.png",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
    "Referer": "https://starzmanga.com/",
    "Accept-Language": "ar,en;q=0.8"
  },
  "latest": {
    "verified": true,
    "firstPageUrl": "/",
    "url": "/page/{page}/",
    "list": "#loop-content .page-item-detail",
    "item": {
      "url": {
        "selector": ".post-title h3 a",
        "attr": "href"
      },
      "title": {
        "selector": ".post-title h3 a",
        "attr": "text"
      },
      "cover": {
        "selector": ".item-thumb img",
        "attr": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "nextPage": ".wp-pagenavi a.nextpostslink"
  },
  "popular": {
    "verified": false,
    "note": "ترتيب المشاهدات في قالب Madara (m_orderby=views).",
    "firstPageUrl": "/manga/?m_orderby=views",
    "url": "/manga/page/{page}/?m_orderby=views",
    "list": "#loop-content .page-item-detail",
    "item": {
      "url": {
        "selector": ".post-title h3 a",
        "attr": "href"
      },
      "title": {
        "selector": ".post-title h3 a",
        "attr": "text"
      },
      "cover": {
        "selector": ".item-thumb img",
        "attr": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "nextPage": ".wp-pagenavi a.nextpostslink"
  },
  "completed": {
    "verified": false,
    "note": "الأعمال المكتملة في قالب Madara (status[]=end).",
    "firstPageUrl": "/manga/?status%5B%5D=end&m_orderby=latest",
    "url": "/manga/page/{page}/?status%5B%5D=end&m_orderby=latest",
    "list": "#loop-content .page-item-detail",
    "item": {
      "url": {
        "selector": ".post-title h3 a",
        "attr": "href"
      },
      "title": {
        "selector": ".post-title h3 a",
        "attr": "text"
      },
      "cover": {
        "selector": ".item-thumb img",
        "attr": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "nextPage": ".wp-pagenavi a.nextpostslink"
  },
  "search": {
    "verified": true,
    "firstPageUrl": "/?s={query}&post_type=wp-manga",
    "url": "/page/{page}/?s={query}&post_type=wp-manga",
    "list": ".c-tabs-item .c-tabs-item__content",
    "item": {
      "url": {
        "selector": ".post-title h3 a, .post-title h4 a",
        "attr": "href"
      },
      "title": {
        "selector": ".post-title h3 a, .post-title h4 a",
        "attr": "text"
      },
      "cover": {
        "selector": ".tab-thumb img",
        "attr": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "nextPage": ".wp-pagenavi a.nextpostslink, .nav-previous a",
    "quickSearch": {
      "verified": true,
      "method": "POST",
      "url": "/wp-admin/admin-ajax.php",
      "form": {
        "action": "wp-manga-search-manga",
        "title": "{query}"
      },
      "response": {
        "listPath": "data",
        "titleField": "title",
        "urlField": "url"
      }
    }
  },
  "coverTransform": [
    {
      "regex": "-\\d{2,4}x\\d{2,4}(?=\\.[A-Za-z0-9]+$)",
      "replace": ""
    }
  ],
  "details": {
    "verified": true,
    "title": {
      "selector": ".profile-manga .post-title h1",
      "attr": "text"
    },
    "cover": {
      "selector": ".profile-manga .summary_image img",
      "attr": [
        "data-src",
        "data-lazy-src",
        "src"
      ]
    },
    "description": {
      "selector": ".description-summary .summary__content",
      "attr": "text"
    },
    "genres": {
      "selector": ".genres-content a",
      "attr": "text",
      "multiple": true
    },
    "status": {
      "selector": ".post-status .post-content_item .summary-content",
      "attr": "text"
    },
    "statusMap": {
      "ongoing": "ongoing",
      "on going": "ongoing",
      "مستمرة": "ongoing",
      "completed": "completed",
      "complete": "completed",
      "مكتملة": "completed"
    }
  },
  "chapters": {
    "verified": true,
    "mangaId": {
      "selector": "#manga-reading-nav-head, .entry-header.header",
      "attr": "data-id",
      "fallback": {
        "selector": "input.rating-post-id",
        "attr": "value"
      }
    },
    "request": {
      "method": "POST",
      "url": "{mangaUrl}ajax/chapters/",
      "headers": {
        "X-Requested-With": "XMLHttpRequest"
      }
    },
    "fallbackRequest": {
      "method": "POST",
      "url": "/wp-admin/admin-ajax.php",
      "headers": {
        "X-Requested-With": "XMLHttpRequest"
      },
      "form": {
        "action": "manga_get_chapters",
        "manga": "{mangaId}"
      }
    },
    "list": "li.wp-manga-chapter",
    "item": {
      "url": {
        "selector": "a",
        "attr": "href"
      },
      "name": {
        "selector": "a",
        "attr": "text"
      },
      "date": {
        "selector": ".chapter-release-date i, .chapter-release-date, .post-on",
        "attr": "text",
        "optional": true
      },
      "dateTitle": {
        "selector": ".chapter-release-date a, .c-new-tag a",
        "attr": "title",
        "optional": true
      }
    },
    "numberFromUrl": "/([0-9]+(?:[.-][0-9]+)?)/?$",
    "order": "desc",
    "dateFormats": [
      "MMMM d, yyyy"
    ],
    "arabicMonths": {
      "يناير": 1,
      "فبراير": 2,
      "مارس": 3,
      "أبريل": 4,
      "مايو": 5,
      "يونيو": 6,
      "يوليو": 7,
      "أغسطس": 8,
      "سبتمبر": 9,
      "أكتوبر": 10,
      "نوفمبر": 11,
      "ديسمبر": 12
    },
    "relativeDatePattern": "^(?:(\\d+)\\s*)?(دقيقة|دقيقتين|دقائق|ساعة|ساعتين|ساعات|يوم|يومين|أيام|اسبوع|أسبوع|أسبوعين|أسابيع|شهر|شهرين|أشهر)\\s*ago$"
  },
  "pages": {
    "verified": true,
    "list": ".reading-content .page-break img",
    "image": {
      "attr": [
        "data-src",
        "data-lazy-src",
        "src"
      ]
    },
    "imageHeaders": {
      "Referer": "https://starzmanga.com/"
    }
  },
  "home": {
    "url": "/",
    "sections": [
      {
        "title": "آخر التحديثات",
        "list": "#loop-content .page-item-detail",
        "item": {
          "url": {
            "selector": ".post-title h3 a",
            "attr": "href"
          },
          "title": {
            "selector": ".post-title h3 a",
            "attr": "text"
          },
          "cover": {
            "selector": ".item-thumb img",
            "attr": [
              "data-src",
              "data-lazy-src",
              "src"
            ]
          }
        }
      }
    ]
  }
}
