{
  "$schema": "../../schema/source.schema.json",
  "schemaVersion": 1,
  "id": "witanime",
  "type": "anime",
  "name": "ويت أنمي (WitAnime)",
  "lang": "ar",
  "version": 2,
  "baseUrl": "https://witanime.site",
  "nsfw": false,
  "iconUrl": "https://witanime.site/favicon.ico",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
    "Referer": "https://witanime.site/",
    "Accept-Language": "ar,en;q=0.8"
  },
  "latest": {
    "verified": true,
    "note": "قائمة الأنمي /browse والترقيم /browse/page/N (114 صفحة). البطاقة [data-preview-card] وزر التالي a[rel=next].",
    "firstPageUrl": "/browse",
    "url": "/browse/page/{page}",
    "list": "[data-preview-card]",
    "item": {
      "url": {
        "selector": "a[data-preview]",
        "attr": "href"
      },
      "title": {
        "selector": "h3",
        "attr": "text"
      },
      "cover": {
        "selector": "img",
        "attr": [
          "data-src",
          "src"
        ]
      },
      "status": {
        "selector": "div.rounded-md.bg-white",
        "attr": "text",
        "optional": true
      }
    },
    "nextPage": "a[rel=next]"
  },
  "search": {
    "verified": false,
    "note": "نموذج البحث يرسل q عبر GET إلى /search. افتُرض أن النتائج بنفس بطاقات [data-preview-card] (لم تُرفق صفحة نتائج للتأكد).",
    "firstPageUrl": "/search?q={query}",
    "url": "/search?q={query}&page={page}",
    "list": "[data-preview-card]",
    "item": {
      "url": {
        "selector": "a[data-preview]",
        "attr": "href"
      },
      "title": {
        "selector": "h3",
        "attr": "text"
      },
      "cover": {
        "selector": "img",
        "attr": [
          "data-src",
          "src"
        ]
      },
      "status": {
        "selector": "div.rounded-md.bg-white",
        "attr": "text",
        "optional": true
      }
    },
    "nextPage": "a[rel=next]"
  },
  "details": {
    "verified": true,
    "title": {
      "selector": "h1 span",
      "attr": "text"
    },
    "cover": {
      "selector": "img.w-48",
      "attr": [
        "data-src",
        "src"
      ]
    },
    "description": {
      "selector": "p.text-neutral-300",
      "attr": "text"
    },
    "genres": {
      "selector": "div.flex-wrap.gap-2 span.rounded-full",
      "attr": "text",
      "multiple": true
    }
  },
  "chapters": {
    "verified": true,
    "inline": true,
    "list": "div.grid.grid-cols-1.gap-3 a[href*=\"/watch/\"]",
    "numberFromUrl": "/(\\d+(?:\\.\\d+)?)/?$",
    "item": {
      "url": {
        "selector": "a",
        "attr": "href"
      },
      "name": {
        "selector": "a",
        "attr": "text"
      }
    }
  },
  "videos": {
    "verified": false,
    "note": "السيرفرات لا تظهر في HTML الصفحة؛ تُحمَّل من نقطة /watch/<slug>/<n>/sources التي ترفض الطلب العادي (404). محددات مؤقتة حتى تُعرف الترويسات وشكل الاستجابة.",
    "list": "[data-server]",
    "name": {
      "selector": "[data-server]",
      "attr": "text"
    },
    "embed": {
      "selector": "[data-server]",
      "attr": "data-url"
    }
  }
}
